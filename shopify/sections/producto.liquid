{% assign v = product.selected_or_first_available_variant %}
{% assign main_photo = v.featured_image | default: product.featured_image %}
<section class="pdp">
  <div class="pdp-gallery">
    <div class="pdp-stage">{% render 'imagen', photo: main_photo, sizes: '(max-width: 899px) 95vw, 50vw', loading: 'eager' %}</div>
    {% if product.images.size > 1 %}
      <div class="pdp-thumbs" role="group" aria-label="Fotos del producto">
        {% for photo in product.images %}
          <a href="{{ photo | image_url: width: 1200 }}" data-photo data-alt="{{ photo.alt | default: product.title | escape }}" aria-label="Ver foto {{ forloop.index }}">
            {% render 'imagen', photo: photo, sizes: '70px', loading: 'lazy' %}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  <div class="pdp-info">
    <h1>{{ product.title | escape }}</h1>
    <p class="pdp-price">{{ v.price | money_with_currency }}</p>
    {% if product.has_only_default_variant == false %}
      <div class="opt"><span class="label">Variante</span><div class="opt-tones">
        {% for option in product.variants %}
          <a class="chip" href="{{ option.url }}" {% if option.id == v.id %}aria-current="true"{% endif %}>{{ option.title | escape }}{% unless option.available %} · Agotada{% endunless %}</a>
        {% endfor %}
      </div></div>
    {% endif %}
    {% form 'product', product, class: 'shop-add' %}
      <input type="hidden" name="id" value="{{ v.id }}">
      <div class="buy-row">
        <label>Cantidad <input type="number" name="quantity" min="1" value="1" required></label>
        <button type="submit" name="add" class="button" {% unless v.available %}disabled{% endunless %}>
          {% if v.available %}Añadir al carrito{% else %}Agotada{% endif %}
        </button>
      </div>
      <p role="alert" data-cart-error></p>
      {{ form.errors | default_errors }}
    {% endform %}
    <div class="acc">
      {% if product.description != blank %}<details open><summary>Descripción</summary><div>{{ product.description }}</div></details>{% endif %}
      {% if product.metafields.custom.medidas != blank %}<details open><summary>Medidas</summary>{{ product.metafields.custom.medidas | metafield_tag }}</details>{% endif %}
      {% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">Envíos y entregas</a>{% endif %}
      {% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">Cambios y devoluciones</a>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Ficha de producto","settings":[]}
{% endschema %}
