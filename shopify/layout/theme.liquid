<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{ page_title | escape }} · {{ shop.name | escape }}</title>
    {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" href="{{ 'isotipo.svg' | asset_url }}" type="image/svg+xml">
    {{ content_for_header }}
    {{ 'tienda.css' | asset_url | stylesheet_tag }}
    {{ 'shop.css' | asset_url | stylesheet_tag }}
  </head>
  <body data-page="{{ request.page_type | escape }}">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <aside class="sidebar">
      {% render 'marca' %}
      <nav class="side-nav" aria-label="Principal">
        <a class="side-item" href="{{ routes.root_url }}">{% render 'icono', name: 'inicio' %}Inicio</a>
        <a class="side-item" href="{{ routes.all_products_collection_url }}">{% render 'icono', name: 'catalogo' %}Catálogo</a>
        <a class="side-item" href="{{ routes.search_url }}">{% render 'icono', name: 'buscar' %}Buscar</a>
        {% if shop.customer_accounts_enabled %}<a class="side-item" href="{{ routes.account_url }}">{% render 'icono', name: 'cuenta' %}Mi cuenta</a>{% endif %}
        <a class="side-item nav-cart" href="{{ routes.cart_url }}">{% render 'icono', name: 'carrito' %}Carrito <span class="badge-count mono" data-count>{{ cart.item_count }}</span></a>
      </nav>
      <button class="link-btn" type="button" data-theme-toggle>Cambiar tema</button>
    </aside>
    <div class="mobile-top">{% render 'marca' %}<button class="link-btn" type="button" data-theme-toggle>Cambiar tema</button></div>
    <main id="contenido" class="main">{{ content_for_layout }}</main>
    <footer class="site-footer band">
      <div class="footer-slot" data-mascot-slot="footer" aria-hidden="true"></div>
      <div class="footer-top">
        <strong>{{ shop.name | escape }}</strong>
        <a href="{{ routes.all_products_collection_url }}">Catálogo</a>
        {% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}
      </div>
    </footer>
    {% section 'panel-carrito' %}
    <script type="module" src="{{ 'shop.js' | asset_url }}"></script>
  </body>
</html>
