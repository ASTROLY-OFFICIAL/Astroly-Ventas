<section class="catalog">
  <h1>{{ collection.title | escape }}</h1>
  <form action="{{ collection.url }}" method="get">
    {% for filter in collection.filters %}
      {% if filter.type == 'list' %}
        <details><summary>{{ filter.label | escape }}</summary>
          {% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %}>{{ value.label | escape }}</label>{% endfor %}
        </details>
      {% endif %}
    {% endfor %}
    <label>Ordenar <select name="sort_by">
      {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
      {% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}
    </select></label>
    <button class="button" type="submit">Aplicar</button>
  </form>
  {% paginate collection.products by 24 %}
    <div class="grid">{% for item in collection.products %}{% render 'tarjeta', item: item, filters: collection.filters %}{% else %}<p>No hay productos con estos filtros.</p>{% endfor %}</div>
    {{ paginate | default_pagination }}
  {% endpaginate %}
</section>
{% schema %}
{"name":"Catálogo","settings":[]}
{% endschema %}
